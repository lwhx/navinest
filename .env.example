PUBLIC_SITE_URL=https://nss.whks.de
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Temporarily paused; set true to restore OAuth after development.
GITHUB_LOGIN_ENABLED=false
# Development phase: reuse the site admin session. Set access to restore Cloudflare Access.
ADMIN_AUTH_MODE=session
# Keep false for a private site. Existing users/bindings can sign in only when GitHub login is enabled.
ALLOW_GITHUB_AUTO_PROVISION=false
SESSION_SECRET=change-me-before-deploy
# Optional: external alert webhook for cron failures (generic JSON, or a WeCom/DingTalk/Feishu bot URL).
ALERT_WEBHOOK_URL=
